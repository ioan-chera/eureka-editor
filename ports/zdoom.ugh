sector 87 "ZD: Outside"

sector 79 "ZD: Low friction"

sector 195 "ZD: Hidden"
sector 196 "ZD: Healing"
sector 200 "ZD: Sky2"

sector 89 "GZD: GLSector_NoSkyDraw"
sector 90 "GZD: GLSector_Skybox"

sector 105 "ZD: Strife Hellslime"
sector 115 "ZD: Instant Death"
sector 116 "ZD: Strife Super Hellslime"

sector 118 "ZD: Strife Tag Current"

sector 197 "ZD: Outdoor Lightning"

sector 2 "ZD: Use Sky 2"

sector 225 "ZD: Htic Carry E 05"
sector 226 "ZD: Htic Carry E 10"
sector 227 "ZD: Htic Carry E 25"
sector 228 "ZD: Htic Carry E 30"
sector 229 "ZD: Htic Carry E 35"

sector 230 "ZD: Htic Carry N 05"
